# 播客 TTS 服务 AI 配置
# 复制此文件为 .env 并填入你的 API 信息

# OpenAI 兼容 API 地址
LLM_API_BASE=https://api.openai.com/v1

# API Key
LLM_API_KEY=sk-xxx

# 模型名称（支持任何 OpenAI 兼容模型）
# 推荐：gpt-4o-mini（便宜快速）、deepseek-chat、qwen-turbo
LLM_MODEL=gpt-4o-mini

# 管理员访问密钥（32位字符，用于控制谁能使用语音生成功能）
# 生成方式：python -c "import secrets; print(secrets.token_hex(16))"
# 访问方式：https://your-site.com/tech-docs/?admin=你的密钥
ADMIN_TOKEN=

# 服务监听配置
# 本地开发：127.0.0.1（默认）
# 服务器部署：0.0.0.0
HOST=0.0.0.0
PORT=3456
